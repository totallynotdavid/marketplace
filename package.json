{
  "name": "sentinel",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings . && oxfmt --check .",
    "fix": "oxlint --type-aware --fix . && oxfmt --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "cf build",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "dev": "cf dev",
    "db:migrate:local": "cf d1 migrations apply 12345678-1234-4234-8234-123456789abc --local --persist-to .cloudflare/state",
    "deploy": "cf deploy",
    "create-admin": "bun scripts/create-admin.ts"
  },
  "dependencies": {
    "hono": "4.13.18",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.31",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
