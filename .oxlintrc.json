{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-debugger": "error",
    "no-alert": "error"
  },
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/.cloudflare/**"],
  "env": {
    "builtin": true
  }
}
