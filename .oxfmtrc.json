{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
    "**/.cloudflare/**",
    "**/.wrangler/**",
    "bun.lock"
  ],
  "overrides": [
    {
      "files": ["**/*.md", "**/*.yml", "**/*.yaml", "**/*.json"],
      "options": { "printWidth": 80, "proseWrap": "always" }
    }
  ]
}
